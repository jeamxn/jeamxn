{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": ["pnpm-lock.yaml"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build", "build"],
      "cache": false
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    }
  },
  "globalEnv": ["JEAMXN_BASE_PATH", "JEAMXN_SITE_URL"],
  "globalPassThroughEnv": [
    "NODE_ENV",
    "WEB_PORT",
    "PDF_TEST_OUTPUT",
    "QA_BASE",
    "QA_BASE_URL",
    "QA_BROWSER_PATH",
    "QA_OUTPUT",
    "QA_WIDTHS",
    "QA_STATIC_CHECK",
    "QA_ENGINES",
    "JEAMXN_HTTP_PORT",
    "QA_SITE_URL"
  ]
}
