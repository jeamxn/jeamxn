{
  "name": "jeamxn",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo dev --filter=@jeamxn/server --filter=@jeamxn/web",
    "build": "turbo build && node scripts/generate-sitemap.mjs",
    "typecheck": "turbo typecheck",
    "lint": "biome check --error-on-warnings . && node scripts/check-boundary.mjs",
    "lint:fix": "biome check --write .",
    "test": "turbo test",
    "test:e2e": "node scripts/verify-browser.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "turbo": "2.10.8",
    "typescript": "~6.0.3",
    "playwright": "^1.63.0"
  }
}
