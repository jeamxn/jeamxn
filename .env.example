# Copy to .env for local development; NEVER commit real secrets.
# Compose uses this at runtime only. No VITE_* secret and no Docker build args.
# Real deployment: set exactly the HTTPS origin attached to web:8080 in Dokploy.
JEAMXN_PUBLIC_ORIGIN=http://127.0.0.1:5412
JEAMXN_HTTP_PORT=5412

# pnpm dev only (not required by production Compose)
WEB_PORT=5410
PORT=5411
JEAMXN_DEV_API_URL=http://127.0.0.1:5411
# With pnpm dev, change JEAMXN_PUBLIC_ORIGIN to http://localhost:5410,http://127.0.0.1:5410.
# Use a dedicated local Valkey instance; never point tests at another app's store.
VALKEY_URL=

# Explicit opt-in. No key/false => local public-content FAQ, NOT live AI.
AI_ENABLED=false
AI_API_KEY=
# An OpenAI-compatible model id; confirm availability/pricing on your account.
AI_MODEL=gpt-4.1-mini
AI_BASE_URL=https://api.openai.com/v1
AI_REQUIRE_VALKEY=true
AI_TIMEOUT_MS=12000
AI_PEER_LIMIT=12
AI_GLOBAL_LIMIT=100
AI_DAILY_LIMIT=300
AI_CONCURRENCY=2
# Normally use the bundled OFL font, no external renderer/Chromium required.
RESUME_FONT_PATH=
