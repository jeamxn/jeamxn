{
  "name": "@jeamxn/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.tsx --format esm --dts --external react",
    "dev": "tsup src/index.tsx --format esm --dts --external react --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "react": "^19.2.8",
    "@jeamxn/token": "workspace:*",
    "@jeamxn/icon": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "~6.0.3",
    "@types/react": "^19.2.18"
  }
}
